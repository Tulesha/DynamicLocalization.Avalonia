<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Central Package Management wants an unambiguous package source per package; this repo
       only ever needs nuget.org, regardless of what other feeds a machine's global NuGet.Config
       registers. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
