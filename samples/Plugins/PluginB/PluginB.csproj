<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>PluginB</RootNamespace>
        <AssemblyName>PluginB</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="localization.json"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Not referenced by SampleApp at compile time: SampleApp loads this assembly dynamically
