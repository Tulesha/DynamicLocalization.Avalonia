        <ProjectReference Include="..\..\..\src\DynamicLocalization.Avalonia.SourceGenerator\DynamicLocalization.Avalonia.SourceGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
