<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:DynamicLocalization.Avalonia.Markup"
             x:Class="DynamicLocalization.Avalonia.HeadlessTests.Views.LocalizeExtensionTestView">
    <StackPanel>
        <TextBlock x:Name="WindowTitleText" x:FieldModifier="public"
                   Text="{loc:Localize PluginA.WindowTitle}" />
        <TextBlock x:Name="WelcomeText" x:FieldModifier="public"
                   Text="{loc:Localize Module=PluginA, Key=Welcome}" />
        <TextBlock x:Name="MissingKeyText" x:FieldModifier="public"
                   Text="{loc:Localize NoSuchModule.NoSuchKey}" />
    </StackPanel>
</UserControl>